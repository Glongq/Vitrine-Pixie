+    if (!show) return nil;
+    SGRArtistDownloadsContext *context = objc_getAssociatedObject(info, &kDownloadsKey);
+    if (!context) {
+        context = [SGRArtistDownloadsContext new];
+        __weak SGRArtistDownloadsContext *weakContext = context;
+        context.action = ^{
+            SGRArtistDownloadsContext *current = weakContext;
+            if (current.uri && current.presenter) show(current.uri, current.name ?: @"Artist", current.presenter);
+        };
+        objc_setAssociatedObject(info, &kDownloadsKey, context, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
