+static NSString *exactArtistURI(NSString *value) {
+    NSString *prefix = @"spotify:artist:";
+    if (![value isKindOfClass:NSString.class] || ![value hasPrefix:prefix]) return nil;
+    NSString *identifier = [value substringFromIndex:prefix.length];
+    NSCharacterSet *invalid = [NSCharacterSet characterSetWithCharactersInString:@"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"].invertedSet;
+    return identifier.length == 22 && [identifier rangeOfCharacterFromSet:invalid].location == NSNotFound ? value : nil;
